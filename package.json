{
  "name": "clx-language",
  "displayName": "clx-language",
  "description": "",
  "icon": "res/icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "clx",
        "path": "./snippets/snippets.json"
      }
    ],
    "languages": [{
      "id": "clx",
      "aliases": ["clx", ""],
      "extensions": [".clx"],
      "icon": {
        "dark": "res/icon.png",
        "light": "res/icon.png"
      },
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "clx",
      "scopeName": "source.clx",
      "path": "./syntaxes/.tmLanguage.json"
    }]
  }
}
