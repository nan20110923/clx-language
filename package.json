{
  "name": "clx-language",
  "displayName": "clx-language",
  "publisher": "LifeSmart",
  "description": "Development tool for coloX",
  "icon": "res/icon.png",
  "version": "1.0.12",
  "repository": {
    "type": "git",
    "url": "https://dev.azure.com/Lifesmart/clx-language/_git/clx-language"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "ColoPlay",
    "ColoX",
    "Cololight"
  ],
  "contributes": {
    "configuration": {
      "title": "clx-language",
      "properties": {
        "clx-language.JAVA_HOME": {
          "type": "string",
          "default": "",
          "description": "Java 11 or above"
        },
        "clx-language.debugger": {
          "type": "string",
          "enum": ["Default", "Nature", "Custom"],
          "default": "Default",
          "description": "Select debugger"
        },
        "clx-language.debuggerCustomPath": {
          "type": "string",
          "default": "",
          "description": "Custom debugger path"
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "extension.clx-language.run",
          "when": "resourceLangId == clx",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.clx-language.run",
          "when": "resourceLangId == clx"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.clx-language.run",
        "title": "Run File",
        "category": "CLX Run",
        "enablement": "!inDebugMode",
        "icon": "$(play)"
      },
      {
        "command": "extension.clx-language.restartServer",
        "title": "CLX: Restart Lua Server"
      }
    ],
    "keybindings":[
      {
        "command": "extension.clx-language.run",
        "key": "f5",
        "mac": "f5",
        "win": "f5",
        "when": "editorTextFocus && resourceLangId == clx"
      }
    ],
    "breakpoints": [
      {
        "language": "clx"
      }
    ],
    "debuggers": [
      {
        "type": "clx_debug",
        "label": "CLX Debugger",
        "program": "./out/debugger/ClxDebugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
            "launch": {
                "required": [
                    "host",
                    "port"
                ],
                "properties": {
                    "host": {
                        "type": "string",
                        "description": "host",
                        "default": "localhost"
                    },
                    "port": {
                        "type": "number",
                        "description": "port",
                        "default": 3563
                    }
                }
            }
        },
        "initialConfigurations": [
            {
                "type": "clx_debug",
                "request": "launch",
                "name": "CLX Debugger",
                "host": "localhost",
                "port": 3563
            }
        ],
        "configurationSnippets": [
            {
                "label": "CLX Debugger",
                "description": "CLX Debugger",
                "body": {
                    "type": "clx_debug",
                    "request": "launch",
                    "name": "CLX Debugger",
                    "host": "localhost",
                    "port": 3563
                }
            }
        ],
        "languages": [
            "clx"
        ]
      }
    ],
    "snippets": [
      {
        "language": "clx",
        "path": "./snippets/snippets.json"
      }
    ],
    "languages": [
      {
        "id": "clx",
        "aliases": [
          "clx"
        ],
        "extensions": [
          ".clx"
        ],
        "icon": {
          "dark": "res/icon.png",
          "light": "res/icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clx",
        "scopeName": "source.clx",
        "path": "./syntaxes/.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --tsconfig=./tsconfig.json --external:vscode --format=cjs --platform=node --outfile=dist/extension.js",
    "watch": "npm run -S esbuild-base -- --sourcemap --sources-content=false --watch",
    "build": "npm run -S esbuild-base -- --sourcemap --sources-content=false",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish-pre-release": "vsce publish --pre-release",
    "vscode:prepublish": "rimraf dist && npm run -S esbuild-base -- --minify",
    "test": "npm run typecheck"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^20.5.9",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "@vscode/debugadapter": "^1.56.0",
    "@vscode/debugadapter-testsupport": "^1.56.0",
    "await-notify": "^1.0.1",
    "base64-js": "^1.5.1",
    "esbuild": "^0.14.29",
    "eslint": "^8.12.0",
    "events": "^3.3.0",
    "glob": "^7.2.0",
    "mocha": "^9.2.2",
    "path-browserify": "^1.0.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.6.3",
    "url": "^0.11.0",
    "vsce": "^2.7.0",
    "vscode-languageclient": "8.0.2"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebug"
  ]
}
