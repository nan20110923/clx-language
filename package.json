{
  "name": "clx-language",
  "displayName": "clx-language",
  "publisher": "LifeSmart",
  "description": "Development tool for coloX",
  "icon": "res/icon.png",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nan20110923/clx-language"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "ColoPlay",
    "ColoX",
    "Cololight"
  ],
  "contributes": {
    "configuration": {
      "title": "clx-language",
      "properties": {
        "clx-language.JAVA_HOME": {
          "type": "string",
          "default": "",
          "description": "Java 11 or above"
        },
        "clx-language.debugger": {
          "type": "string",
          "enum": [
            "Default",
            "Nature",
            "Custom"
          ],
          "enumDescriptions": [
            "Use the emulator downloaded by the extension.",
            "Deprecated: the Nature emulator is no longer published separately; behaves like Default.",
            "Use the program at 'clx-language.debuggerCustomPath' and never download."
          ],
          "default": "Default",
          "description": "Select the ColoX emulator to run"
        },
        "clx-language.debuggerCustomPath": {
          "type": "string",
          "default": "",
          "description": "Path to a local ColoX emulator. Only used when 'clx-language.debugger' is 'Custom'."
        },
        "clx-language.colors.parameter": {
          "type": "string",
          "default": "#9CDCFE",
          "description": "Parameter name colour (clx annotator)."
        },
        "clx-language.colors.global": {
          "type": "string",
          "default": "#4FC1FF",
          "description": "Global variable colour (clx annotator)."
        },
        "clx-language.colors.doc_type": {
          "type": "string",
          "default": "#4EC9B0",
          "description": "Type name colour (clx annotator)."
        },
        "clx-language.colors.upvalue": {
          "type": "string",
          "default": "",
          "description": "Upvalue underline colour (clx annotator). Empty disables the underline."
        },
        "clx-language.colors.not_use": {
          "type": "string",
          "default": "#808080",
          "description": "Unused variable colour (clx annotator)."
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "extension.clx-language.run",
          "when": "resourceLangId == clx",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.clx-language.run",
          "when": "resourceLangId == clx"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.clx-language.run",
        "title": "Run File",
        "category": "CLX Run",
        "enablement": "!inDebugMode",
        "icon": "$(play)"
      },
      {
        "command": "extension.clx-language.restartServer",
        "title": "CLX: Restart Lua Server"
      },
      {
        "command": "extension.clx-language.injectButtons",
        "title": "Inject Buttons",
        "category": "CLX Test",
        "enablement": "inDebugMode"
      },
      {
        "command": "extension.clx-language.injectKey",
        "title": "Hold a Key",
        "category": "CLX Test",
        "enablement": "inDebugMode"
      },
      {
        "command": "extension.clx-language.injectMouse",
        "title": "Move or Touch",
        "category": "CLX Test",
        "enablement": "inDebugMode"
      },
      {
        "command": "extension.clx-language.screenshot",
        "title": "Screenshot",
        "category": "CLX Test",
        "enablement": "inDebugMode"
      },
      {
        "command": "extension.clx-language.inputState",
        "title": "Show Input State",
        "category": "CLX Test",
        "enablement": "inDebugMode"
      }
    ],
    "keybindings": [
      {
        "command": "extension.clx-language.run",
        "key": "f5",
        "mac": "f5",
        "win": "f5",
        "when": "editorTextFocus && resourceLangId == clx"
      }
    ],
    "breakpoints": [
      {
        "language": "clx"
      }
    ],
    "debuggers": [
      {
        "type": "clx_debug",
        "label": "CLX Debugger",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "host": {
                "type": "string",
                "description": "Debug channel host. Defaults to 127.0.0.1.",
                "default": "127.0.0.1"
              },
              "port": {
                "type": "number",
                "description": "Debug channel port. Defaults to 3563.",
                "default": 3563
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "clx_debug",
            "request": "launch",
            "name": "CLX Debugger",
            "host": "127.0.0.1",
            "port": 3563
          }
        ],
        "configurationSnippets": [
          {
            "label": "CLX Debugger",
            "description": "CLX Debugger",
            "body": {
              "type": "clx_debug",
              "request": "launch",
              "name": "CLX Debugger",
              "host": "127.0.0.1",
              "port": 3563
            }
          }
        ],
        "languages": [
          "clx"
        ]
      }
    ],
    "snippets": [
      {
        "language": "clx",
        "path": "./snippets/snippets.json"
      }
    ],
    "languages": [
      {
        "id": "clx",
        "aliases": [
          "clx"
        ],
        "extensions": [
          ".clx"
        ],
        "icon": {
          "dark": "res/icon.png",
          "light": "res/icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clx",
        "scopeName": "source.clx",
        "path": "./syntaxes/.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --tsconfig=./tsconfig.json --external:vscode --format=cjs --platform=node --outfile=dist/extension.js",
    "watch": "npm run -S esbuild-base -- --sourcemap --sources-content=false --watch",
    "build": "npm run -S esbuild-base -- --sourcemap --sources-content=false",
    "package": "node -e \"require('fs').mkdirSync('.artifacts',{recursive:true})\" && vsce package --no-dependencies --out .artifacts/",
    "publish": "vsce publish",
    "publish-pre-release": "vsce publish --pre-release",
    "vscode:prepublish": "rimraf dist && npm run -S esbuild-base -- --minify",
    "test": "node scripts/run-tests.mjs",
    "e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@vscode/debugadapter": "1.68.0",
    "@vscode/debugprotocol": "1.68.0",
    "vscode-languageclient": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.91.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "rimraf": "^6.1.4",
    "typescript": "5.9.3"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:clx",
    "onDebugResolve:clx_debug"
  ]
}
